# ==============================================================================
# FLOYDIA AI COMMAND & OBSERVATORY SUITE — Configuración de Entorno de Ejemplo
# Copia este archivo a .env y rellena con tus claves API correspondientes
# ==============================================================================

# Google AI Studio (Cuentas C1 a C6 / Gemini Pro y Flash)
C1_GOOGLE_AISTUDIO=AIzaSy...
C2_GOOGLE_AISTUDIO=
GEMINI_API_KEY=

# DeepSeek API (Direct V3 / Reasoner R1)
DEEPSEEK_API_KEY=sk-...
C1_DEEPSEEK=

# OpenRouter (Fleet & Multi-Model)
OPENROUTER_API_KEY=sk-or-v1-...
C1_OPENROUTER=

# Mistral AI
MISTRAL_API_KEY=
C1_MISTRAL=

# NVIDIA NIM
NVIDIA_API_KEY=nvapi-...
C7_NVIDIA=

# Groq LPU
GROQ_API_KEY=gsk_...
C7_GROQ=

# GitHub Models
GITHUB_TOKEN=ghp_...
